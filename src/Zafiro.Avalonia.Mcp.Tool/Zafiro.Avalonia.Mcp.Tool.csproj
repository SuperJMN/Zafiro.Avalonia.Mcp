<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Description>MCP server tool for Avalonia app inspection, interaction and video capture</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zafiro-avalonia-mcp</ToolCommandName>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zafiro.Avalonia.Mcp.Protocol\Zafiro.Avalonia.Mcp.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Preview\PreviewHost.template.cs" />
    <EmbeddedResource Include="Preview\PreviewHost.template.cs" LogicalName="Zafiro.Avalonia.Mcp.Tool.Preview.PreviewHost.template.cs" />
    <EmbeddedResource Include="Preview\PreviewNativeAssetResolver.cs" LogicalName="Zafiro.Avalonia.Mcp.Tool.Preview.PreviewNativeAssetResolver.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zafiro.Avalonia.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="$(McpSdkVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
  </ItemGroup>

  <Target Name="RemoveSymbolsFromToolPackage" BeforeTargets="PackTool">
    <ItemGroup>
      <_ToolPackageSymbols Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>

    <Delete Files="@(_ToolPackageSymbols)" />
  </Target>

</Project>
